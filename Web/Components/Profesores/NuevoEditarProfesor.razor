<div class="modal fade" id="NuevoEditarProfesor" tabindex="-1"
     aria-labelledby="tituloModalProfesor" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-custom-width">
        <div class="modal-content custom-modal-content">

            <!-- CABECERA -->
            <div class="modal-header custom-modal-header text-white py-2 px-3">
                <div>
                    <h6 class="modal-title fw-bold mb-0" id="tituloModalProfesor">
                        @(Profesor?.Id > 0 ? "Editar profesor" : "Nuevo profesor")
                    </h6>
                    <small class="modal-subtitle opacity-75">Complete la información del profesor</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <!-- FORMULARIO DE BLAZOR -->
            <EditForm Model="@Profesor" OnValidSubmit="HandleGuardar">
                <DataAnnotationsValidator />

                <!-- CUERPO -->
                <div class="modal-body p-3">
                    <div class="row g-2">
                        <!-- Nombre -->
                        <div class="col-12">
                            <label for="nombreInput" class="custom-form-label">
                                Nombre del profesor <span class="text-danger">*</span>
                            </label>
                            <InputText id="nombreInput" class="form-control custom-form-input"
                                       @bind-Value="Profesor.Nombre"
                                       placeholder="Ej.: Juan Pérez" />
                            <ValidationMessage For="@(() => Profesor.Nombre)" class="text-danger small mt-1" />
                        </div>

                        <!-- Activo -->
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch m-0 d-flex align-items-center">
                                <InputCheckbox id="activoInput" class="form-check-input filter-switch-input me-2"
                                               @bind-Value="Profesor.Activo" />
                                <label class="form-check-label fw-semibold text-dark mb-0" for="activoInput">
                                   Profesor Activo
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PIE DE PÁGINA -->
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-3 fw-semibold"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-action-primary px-4 fw-semibold">
                        Guardar cambios
                    </button>
                </div>
            </EditForm>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public Profesor Profesor { get; set; } = new();

    [Parameter]
    public EventCallback<Profesor> OnGuardar { get; set; }

    private async Task HandleGuardar()
    {
        if (OnGuardar.HasDelegate)
        {
            await OnGuardar.InvokeAsync(Profesor);
        }
    }
}