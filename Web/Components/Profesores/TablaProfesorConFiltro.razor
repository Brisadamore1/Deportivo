@using Service.Models

<!-- TABLA EN TARJETA -->
<div class="table-card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;">Id</th>
                    <th>Nombre y Apellido</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center" style="width: 180px;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var profesor in ListEntity)
                {
                    <tr @key="profesor.Id">
                        <td class="fw-bold text-muted">#@profesor.Id</td>
                        <td class="fw-semibold text-dark">@profesor.Nombre</td>

                        <!-- ESTADO BADGE -->
                        <td class="text-center">
                            @if (profesor.Activo)
                            {
                                <span class="badge badge-pastel-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge badge-pastel-secondary">Inactivo</span>
                            }
                        </td>

                        <!-- ACCIONES -->
                        <td class="text-center">
                            @if (MostrarEliminados)
                            {
                                <button type="button"
                                        title="Restaurar profesor"
                                        class="btn btn-custom-success btn-sm me-1"
                                        @onclick="() => HandleRestaurar(profesor)">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Restaurar
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        title="Modificar profesor"
                                        class="btn btn-custom-edit btn-sm me-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#NuevoEditarProfesor"
                                        @onclick="() => HandleModificar(profesor)">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>

                                <button type="button"
                                        title="Eliminar profesor"
                                        class="btn btn-custom-danger btn-sm"
                                        @onclick="() => HandleEliminar(profesor)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public List<Profesor> ListEntity { get; set; } = new();

    [Parameter]
    public bool MostrarEliminados { get; set; }

    [Parameter]
    public EventCallback<Profesor> OnModificar { get; set; }

    [Parameter]
    public EventCallback<Profesor> OnEliminar { get; set; }

    [Parameter]
    public EventCallback<Profesor> OnRestaurar { get; set; }

    private async Task HandleModificar(Profesor profesor)
    {
        await OnModificar.InvokeAsync(profesor);
    }

    private async Task HandleEliminar(Profesor profesor)
    {
        await OnEliminar.InvokeAsync(profesor);
    }

    private async Task HandleRestaurar(Profesor profesor)
    {
        await OnRestaurar.InvokeAsync(profesor);
    }
}