@page "/login"
@inject FirebaseAuthService _firebaseAuthService
@inject SweetAlertService _sweetAlert
@inject NavigationManager _navigationManager
@inject IUsuarioService _usuarioService
@rendermode InteractiveServer


@if (!isAuthenticated)
{
    <div class="auth-wrapper">
        <div class="card login-card shadow-lg border-0 rounded-4" style="border: 1px solid #e2e8f0 !important; border-radius: 1rem !important; overflow: hidden;">
            <div class="card-header text-white border-0 py-3" style="background-color: #274472;">
                <div class="d-flex align-items-center">
                    <span class="me-2 fs-4">🔐</span>
                    <div>
                        <h5 class="mb-0 fw-semibold text-white">Iniciar sesión</h5>
                        <small class="opacity-75">Bienvenido a Club Deportivo Kairos</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5" style="background-color: #ffffff;">
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: #274472;">Correo electrónico</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white text-muted" style="border-color: #cbd5e1; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <InputText class="form-control" style="border-color: #cbd5e1; font-size: 0.9rem; border-top-right-radius: 10px; border-bottom-right-radius: 10px;" @bind-Value="email" placeholder="usuario@gmail.com" autocomplete="email" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: #274472;">Contraseña</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white text-muted" style="border-color: #cbd5e1; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                            <i class="bi bi-lock"></i>
                        </span>
                        <InputText class="form-control" style="border-color: #cbd5e1; font-size: 0.9rem; border-top-right-radius: 10px; border-bottom-right-radius: 10px;" @bind-Value="password" placeholder="••••••••" type="password" autocomplete="current-password" />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <InputCheckbox id="rememberMe" class="form-check-input" @bind-Value="rememberPassword" />
                        <label class="form-check-label ms-1 text-secondary" for="rememberMe">Recordar contraseña</label>
                    </div>
                    <small>
                        <NavLink class="text-decoration-none" style="cursor:pointer; color: #274472;" @onclick="RecoveryPassword">
                            <i class="bi bi-question-circle me-1"></i> ¿Olvidaste tu contraseña?
                        </NavLink>
                    </small>
                </div>

                <button class="btn w-100 mb-3 text-white fw-semibold rounded-3 py-2" style="background-color: #274472;" @onclick="Loguear">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Acceder
                </button>
                <ActivityIndicator IsBusy="isBusy" Mensaje="Iniciando sesión..." />

                <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                    <button class="btn btn-outline-secondary rounded-3 px-3 py-2" @onclick="RegisterMe">
                        <i class="bi bi-person-plus me-1"></i> Registrarme
                    </button>
                    <button class="btn btn-outline-danger rounded-3 px-3 py-2" @onclick="LoginWithGoogle">
                        <i class="bi bi-google me-1"></i> Google
                    </button>
                </div>
            </div>

            <div class="card-footer bg-white text-body-secondary text-center small py-3" style="border-top: 1px solid #e2e8f0;">
                Desarrollo 3er año - TSDS - 2025
            </div>
        </div>
    </div>
}
else
{
    <div class="auth-wrapper">
        <div class="card login-card shadow-lg border-0 rounded-4 text-center" style="border: 1px solid #e2e8f0 !important; border-radius: 1rem !important; overflow: hidden;">
            <div class="card-header text-white border-0 py-3" style="background-color: #274472;">
                <div class="d-flex align-items-center justify-content-center">
                    <span class="me-2 fs-4">🔓</span>
                    <div>
                        <h5 class="mb-0 fw-semibold text-white">Cerrar sesión</h5>
                        <small class="opacity-75">Cerrar sesión de Club Deportivo Kairos</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5" style="background-color: #ffffff;">
                <p class="mb-4 text-secondary">¿Deseas finalizar tu sesión?</p>
                <button class="btn text-white fw-semibold rounded-3 px-4 py-2" style="background-color: #274472;" @onclick="Desloguear">
                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                </button>
            </div>

            <div class="card-footer bg-white text-body-secondary text-center small py-3" style="border-top: 1px solid #e2e8f0;">
                Desarrollo 3er año - TSDS - 2025
            </div>
        </div>
    </div>
}
@code {
    bool isAuthenticated = false;
    string email = string.Empty;
    string password = string.Empty;
    bool rememberPassword = false;
    bool isBusy = false;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isAuthenticated = await _firebaseAuthService.IsUserAuthenticated();
            StateHasChanged();
        }
    }

    private async Task Loguear()
    {
        if (isBusy)
            return;

        try
        {
            isBusy = true;
            StateHasChanged();

            var user = await _firebaseAuthService.SignInWithEmailPassword(
                email,
                password,
                rememberPassword);

            if (user is null)
            {
                await _sweetAlert.FireAsync(
                    "Error de autenticación",
                    "Correo o contraseña incorrectos.",
                    SweetAlertIcon.Error);

                return;
            }

            if (!user.EmailVerified)
            {
                await _firebaseAuthService.SignOut();

                await _sweetAlert.FireAsync(
                    "Verificación de correo",
                    "Por favor, verifica tu correo electrónico antes de iniciar sesión.",
                    SweetAlertIcon.Warning);

                return;
            }

            // Firebase validó la contraseña.
            // Solo comprobamos que el usuario esté registrado en tu sistema.
            var usuarioSistema = await _usuarioService.GetByEmailAsync(user.Email);

            if (usuarioSistema is null)
            {
                await _firebaseAuthService.SignOut();

                await _sweetAlert.FireAsync(
                    "Error",
                    "El usuario no está registrado en el sistema.",
                    SweetAlertIcon.Error);

                return;
            }

            isAuthenticated = true;
        }
        catch (Exception ex)
        {
            await _firebaseAuthService.SignOut();

            await _sweetAlert.FireAsync(
                "Error al iniciar sesión",
                ex.Message,
                SweetAlertIcon.Error);
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    private async Task Desloguear()
    {
        isAuthenticated = false;
        email = string.Empty;
        password = string.Empty;
        await _firebaseAuthService.SignOut();
        StateHasChanged();
    }

    private async Task RegisterMe()
    {
        _navigationManager.NavigateTo("/signin");

    }
    private async Task LoginWithGoogle()
    {
        var user = await _firebaseAuthService.LoginWithGoogle();
        if (user != null)
        {
            isAuthenticated = true;
            await _firebaseAuthService.IsUserAuthenticated();
            StateHasChanged();
        }
        else
        {
            await _sweetAlert.FireAsync("Error de autenticación", "No se pudo iniciar sesión con Google.", SweetAlertIcon.Error);
        }
    }
    private void RecoveryPassword()
    {
        _navigationManager.NavigateTo("/recovery");
    }

}