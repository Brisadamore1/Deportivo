@page "/signin"
@inject SweetAlertService sweetAlert
@inject FirebaseAuthService firebaseAuthService
@inject NavigationManager navigationManager
@inject IUsuarioService _usuarioService
@rendermode InteractiveServer

<div class="auth-wrapper">
    <div class="card register-card shadow-lg border-0 rounded-4" style="border: 1px solid #e2e8f0 !important; border-radius: 1rem !important; overflow: hidden;">
        <div class="card-header text-white border-0 py-3" style="background-color: #274472;">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-4">📝</span>
                <div>
                    <h5 class="mb-0 fw-semibold text-white">Crear cuenta</h5>
                    <small class="opacity-75">Regístrate para continuar</small>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5" style="background-color: #ffffff;">
            <EditForm Model="usuario">
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="Nombre" style="color: #274472;">Nombre <span class="text-danger">*</span></label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white text-muted" style="border-color: #cbd5e1; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                            <i class="bi bi-person"></i>
                        </span>
                        <InputText id="Nombre" class="form-control" style="border-color: #cbd5e1; font-size: 0.9rem; border-top-right-radius: 10px; border-bottom-right-radius: 10px;" @bind-Value="usuario.Nombre" placeholder="Nombre y apellido" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="email" style="color: #274472;">Email <span class="text-danger">*</span></label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white text-muted" style="border-color: #cbd5e1; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <InputText id="email" class="form-control" style="border-color: #cbd5e1; font-size: 0.9rem; border-top-right-radius: 10px; border-bottom-right-radius: 10px;" @bind-Value="usuario.Email" placeholder="usuario@gmail.com" type="email" autocomplete="email" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="dni" style="color: #274472;">DNI <span class="text-danger">*</span></label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white text-muted" style="border-color: #cbd5e1; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                            <i class="bi bi-card-text"></i>
                        </span>
                        <InputText id="dni" class="form-control" style="border-color: #cbd5e1; font-size: 0.9rem; border-top-right-radius: 10px; border-bottom-right-radius: 10px;" @bind-Value="usuario.Dni" placeholder="12345678" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="domicilio" style="color: #274472;">Domicilio</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white text-muted" style="border-color: #cbd5e1; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                            <i class="bi bi-house"></i>
                        </span>
                        <InputText id="domicilio" class="form-control" style="border-color: #cbd5e1; font-size: 0.9rem; border-top-right-radius: 10px; border-bottom-right-radius: 10px;" @bind-Value="usuario.Domicilio" placeholder="Calle 123, Ciudad" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="telefono" style="color: #274472;">Teléfono</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white text-muted" style="border-color: #cbd5e1; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                            <i class="bi bi-telephone"></i>
                        </span>
                        <InputText id="telefono" class="form-control" style="border-color: #cbd5e1; font-size: 0.9rem; border-top-right-radius: 10px; border-bottom-right-radius: 10px;" @bind-Value="usuario.Telefono" placeholder="3498345678" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="tipoRol" style="color: #274472;">Tipo de Rol <span class="text-danger">*</span></label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white text-muted" style="border-color: #cbd5e1; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                            <i class="bi bi-person-badge"></i>
                        </span>
                        <InputText id="tipoRol"
                                   class="form-control"
                                   style="border-color: #cbd5e1; font-size: 0.9rem;"
                                   Value="Profesor"
                                   readonly />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="password" style="color: #274472;">Contraseña <span class="text-danger">*</span></label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white text-muted" style="border-color: #cbd5e1; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                            <i class="bi bi-lock"></i>
                        </span>
                        <InputText id="password" class="form-control border-end-0" style="border-color: #cbd5e1; font-size: 0.9rem;" @bind-Value="usuario.Password" placeholder="••••••••" type="@(_showPassword ? "text" : "password")" autocomplete="new-password" />
                        <button type="button" class="btn btn-outline-secondary bg-white text-muted" style="border-color: #cbd5e1; border-top-right-radius: 10px; border-bottom-right-radius: 10px;" @onclick="() => _showPassword = !_showPassword">
                            <i class="bi @( _showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold" for="passwordverify" style="color: #274472;">Verificar contraseña <span class="text-danger">*</span></label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white text-muted" style="border-color: #cbd5e1; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                            <i class="bi bi-shield-lock"></i>
                        </span>
                        <InputText id="passwordverify" class="form-control border-end-0" style="border-color: #cbd5e1; font-size: 0.9rem;" @bind-Value="passwordverify" placeholder="Repite tu contraseña" type="@(_showPasswordVerify ? "text" : "password")" autocomplete="new-password" />
                        <button type="button" class="btn btn-outline-secondary bg-white text-muted" style="border-color: #cbd5e1; border-top-right-radius: 10px; border-bottom-right-radius: 10px;" @onclick="() => _showPasswordVerify = !_showPasswordVerify">
                            <i class="bi @( _showPasswordVerify ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <button type="button" class="btn w-100 mb-2 text-white fw-semibold rounded-3 py-2" style="background-color: #274472;" @onclick="Register" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    <i class="bi bi-person-check me-1"></i> Enviar
                </button>

                <div class="text-center mt-2">
                    <small class="text-muted">
                        ¿Ya tienes cuenta?
                        <a class="text-decoration-none fw-semibold" style="color: #274472;" href="/login">Inicia sesión</a>
                    </small>
                </div>
            </EditForm>
        </div>

        <div class="card-footer bg-white text-body-secondary text-center small py-3" style="border-top: 1px solid #e2e8f0;">
            Club Deportivo
        </div>
    </div>
</div>

@code {
    Usuario usuario = new() { TipoRol = TipoRolEnum.Profesor };
    string passwordverify = string.Empty;

    bool _showPassword = false;
    bool _showPasswordVerify = false;
    bool _isSubmitting = false;

    //Data control es el control de los datos ingresados por el usuario antes de enviarlos al servidor. La tarea de esta función es verificar que todos los campos obligatorios estén completos y que las contraseñas coincidan. Si hay algún error, se muestra un mensaje de alerta al usuario y la función devuelve false. Si todo está correcto, devuelve true.

    private async Task<bool> DataControl()
    {
        if (string.IsNullOrWhiteSpace(usuario.Nombre) ||
            string.IsNullOrWhiteSpace(usuario.Email) ||
            string.IsNullOrWhiteSpace(usuario.Dni) ||
            string.IsNullOrWhiteSpace(usuario.Password) ||
            string.IsNullOrWhiteSpace(passwordverify))
        {
            await sweetAlert.FireAsync(
                "Error",
                "Por favor, completa todos los campos obligatorios.",
                SweetAlertIcon.Error);

            return false;
        }

        // Validación de formato de email
        if (!Regex.IsMatch(usuario.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            await sweetAlert.FireAsync(
                "Error",
                "El email no tiene un formato válido.",
                SweetAlertIcon.Error);

            return false;
        }

        // Nombre
        if (usuario.Nombre.Trim().Length < 3)
        {
            await sweetAlert.FireAsync(
                "Error",
                "El nombre debe tener al menos 3 caracteres.",
                SweetAlertIcon.Error);

            return false;
        }

        if (usuario.Nombre.Any(char.IsDigit))
        {
            await sweetAlert.FireAsync(
                "Error",
                "El nombre no puede contener números.",
                SweetAlertIcon.Error);

            return false;
        }

        // DNI: solo números
        if (!usuario.Dni.All(char.IsDigit))
        {
            await sweetAlert.FireAsync(
                "Error",
                "El DNI solo puede contener números.",
                SweetAlertIcon.Error);

            return false;
        }

        if (usuario.Dni.Length < 7 || usuario.Dni.Length > 8)
        {
            await sweetAlert.FireAsync(
                "Error",
                "El DNI debe tener entre 7 y 8 dígitos.",
                SweetAlertIcon.Error);

            return false;
        }

        // Teléfono (si fue ingresado)
        if (!string.IsNullOrWhiteSpace(usuario.Telefono) &&
             !usuario.Telefono.All(char.IsDigit))
        {
            await sweetAlert.FireAsync(
                "Error",
                "El teléfono solo puede contener números.",
                SweetAlertIcon.Error);

            return false;
        }


        if (usuario.Password != passwordverify)
        {
            await sweetAlert.FireAsync(
                "Error",
                "Las contraseñas no coinciden.",
                SweetAlertIcon.Error);

            return false;
        }

        if (usuario.Password.Length < 6)
        {
            await sweetAlert.FireAsync(
                "Error",
                "La contraseña debe tener al menos 6 caracteres.",
                SweetAlertIcon.Error);

            return false;
        }

        return true;
    }

    private async Task Register()
    {
        usuario.Nombre = usuario.Nombre.Trim();
        usuario.Email = usuario.Email.Trim();
        usuario.Dni = usuario.Dni.Trim();
        usuario.Domicilio = usuario.Domicilio.Trim();
        usuario.Telefono = usuario.Telefono.Trim();

        if (!await DataControl())
            return;

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var usuarioExistente = await _usuarioService.GetByEmailAsync(usuario.Email);

            if (usuarioExistente != null)
            {
                await sweetAlert.FireAsync("Error","Ya existe un usuario registrado con ese correo electrónico.",SweetAlertIcon.Error);

                return;
            }

            var usuarioExistenteDni = await _usuarioService.GetByDniAsync(usuario.Dni);

            if (usuarioExistenteDni  != null)
            {
                await sweetAlert.FireAsync("Error","Ya existe un usuario registrado con ese DNI.",SweetAlertIcon.Error);

                return;
            }

            var loginResponse = await firebaseAuthService
                    .createUserWithEmailAndPassword(
                    usuario.Email,
                    usuario.Password,
                    usuario.Nombre);

            if (string.IsNullOrEmpty(loginResponse?.UserUid))
            {
                await sweetAlert.FireAsync("Error",loginResponse?.Error ?? "No se pudo crear el usuario en Firebase.",SweetAlertIcon.Error);

                return;
            }

            var passwordOriginal = usuario.Password;

            var usuarioGuardar = new Usuario
                {
                    Nombre = usuario.Nombre,
                    Email = usuario.Email,
                    Password = passwordOriginal.GetHashSha256(),
                    TipoRol = usuario.TipoRol,
                    FechaRegistracion = usuario.FechaRegistracion,
                    Dni = usuario.Dni,
                    Domicilio = usuario.Domicilio,
                    Telefono = usuario.Telefono,
                    Observacion = usuario.Observacion,
                    IsDeleted = usuario.IsDeleted
                };

            var usuarioNuevo = await _usuarioService.AddAsync(usuarioGuardar);

            if (usuarioNuevo is null)
            {
                await sweetAlert.FireAsync("Error","No se pudo registrar el usuario en el sistema.",SweetAlertIcon.Error);

                return;
            }

            await sweetAlert.FireAsync("Éxito","Usuario registrado correctamente. Revisa tu correo para verificar la cuenta.",SweetAlertIcon.Success);

            await firebaseAuthService.SignOut();

            usuario = new Usuario { TipoRol = TipoRolEnum.Profesor };
            passwordverify = string.Empty;

            navigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
           await sweetAlert.FireAsync("Error","Ocurrió un error al registrar el usuario.",SweetAlertIcon.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }
}