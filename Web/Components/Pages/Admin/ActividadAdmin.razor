@page "/admin/actividades"
@inject NavigationManager _navigationManager
@inject IActivityService _actividadService
@inject SweetAlertService _sweetAlert
@rendermode InteractiveServer

@if (actividades == null)
{
    <div class="d-flex align-items-center justify-content-center min-vh-50 py-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        @* --- 1. Encabezado --- *@
        <EncabezadoPage Titulo="Administración de Actividades" Descripcion="Gestiona las actividades deportivas del club" />

        @* --- 2. Filtro arriba (ÚNICO buscador) --- *@
        <div class="mx-auto mb-4" style="max-width:500px;">
            <div class="search-box-container mb-4">
                <div class="input-group search-input-group">
                    <span class="input-group-text bg-transparent border-end-0 px-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input id="filterText"
                           type="text"
                           class="form-control border-start-0 ps-2"
                           value="@filterText"
                           @oninput="FilterList"
                           placeholder="Filtrar por nombre, profesor o nivel..." />
                </div>
            </div>
        </div>

        @* --- 3. Resultados de búsqueda en el medio --- *@
        <div class="row mb-3">
            <div class="col-12">
                <ResultadoBusqueda Cantidad="actividadesFiltradas.Count" TextoResultado="@(actividadesFiltradas.Count == 1 ? "actividad encontrada" : "actividades encontradas")" />

                @* Estado sin resultados *@
                @if (actividadesFiltradas.Count == 0 && !isLoading)
                {
                    <div class="card shadow-sm border-0 rounded-4 my-3 bg-light">
                        <div class="card-body text-center py-5 px-4">
                            <div class="mb-3">
                                <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">Sin resultados</h5>
                            <p class="text-secondary mb-2">
                                @(MostrarEliminados ? "No hay actividades eliminadas." : "No hay actividades registradas.")
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* --- 4. Botón Nuevo y Ver eliminados antes de la tabla --- *@
        <div class="mb-4">
            <SeccionBtnNuevoMostrarEliminados TargetModal="#NuevoEditarActividad"
                                              @bind-MostrarEliminados="MostrarEliminados"
                                              OnAfterMostrarEliminados="GetActividades"
                                              OnNuevo="Nuevo" />
        </div>

        @* --- 5. Tabla de actividades (Renderiza solo las filtradas, sin buscador interno duplicado) --- *@
        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Actualizando...</span>
                </div>
            </div>
        }
        else if (actividadesFiltradas != null && actividadesFiltradas.Count > 0)
        {
            <TablaActividadConFiltro ListEntity="actividadesFiltradas"
                                     OnEliminar="Eliminar"
                                     OnModificar="Modificar"
                                     OnRestaurar="Restaurar"
                                     MostrarEliminados="MostrarEliminados" />
        }
    </div>
}

<NuevoEditarActividad Actividad="@actividadCurrent"
                      OnGuardar="Guardar" />

@code {
    List<Actividad>? actividades = null;
    List<Actividad> actividadesFiltradas = new();
    Actividad actividadCurrent = new();
    string filterText = "";

    bool isLoading = true;

    public bool MostrarEliminados { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetActividades();
    }

    private async Task GetActividades()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            actividades = MostrarEliminados
                ? await _actividadService.GetAllDeletedsAsync() ?? new List<Actividad>()
                : await _actividadService.GetAllAsync() ?? new List<Actividad>();

            AplicarFiltro(filterText);
        }
        catch
        {
            actividades = new List<Actividad>();
            actividadesFiltradas = new List<Actividad>();
            await _sweetAlert.FireAsync(
                "Error",
                "No se pudieron cargar las actividades.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void FilterList(ChangeEventArgs e)
    {
        filterText = e.Value?.ToString() ?? "";
        AplicarFiltro(filterText);
    }

    private void AplicarFiltro(string texto)
    {
        filterText = texto;

        if (actividades is null)
        {
            actividadesFiltradas = new();
            return;
        }

        if (string.IsNullOrWhiteSpace(filterText))
        {
            actividadesFiltradas = actividades.ToList();
            return;
        }

        actividadesFiltradas = actividades
            .Where(a =>
                (a.Nombre?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Profesor?.Nombre?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Nivel?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();
    }

    private void Modificar(Actividad actividad)
    {
        actividadCurrent = actividad;
    }

    private void Nuevo()
    {
        actividadCurrent = new Actividad();
    }

    private async Task Eliminar(Actividad actividad)
    {
        var respuesta = await _sweetAlert.FireAsync(new SweetAlertOptions
        {
            Title = "Eliminando actividad",
            Text = $"¿Está seguro que desea eliminar la actividad {actividad.Nombre}?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (!respuesta.IsConfirmed)
            return;

        try
        {
            isLoading = true;

            await _actividadService.DeleteAsync(actividad.Id);
            await GetActividades();

            await _sweetAlert.FireAsync(
                "Eliminada",
                "La actividad fue eliminada exitosamente.",
                SweetAlertIcon.Success);
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al eliminar la actividad.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Guardar(Actividad actividadToSave)
    {
        try
        {
            isLoading = true;

            if (actividadToSave.Id == 0)
            {
                await _actividadService.AddAsync(actividadToSave);

                await _sweetAlert.FireAsync(
                    "Creada",
                    "La actividad fue creada exitosamente.",
                    SweetAlertIcon.Success);
            }
            else
            {
                await _actividadService.UpdateAsync(actividadToSave);

                await _sweetAlert.FireAsync(
                    "Actualizada",
                    "La actividad fue actualizada exitosamente.",
                    SweetAlertIcon.Success);
            }

            await GetActividades();
            actividadCurrent = new Actividad();
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al guardar la actividad.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Restaurar(Actividad actividad)
    {
        var respuesta = await _sweetAlert.FireAsync(new SweetAlertOptions
        {
            Title = "Restaurando actividad",
            Text = $"¿Está seguro que desea restaurar la actividad {actividad.Nombre}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, restaurar",
            CancelButtonText = "Cancelar"
        });

        if (!respuesta.IsConfirmed)
            return;

        try
        {
            isLoading = true;

            await _actividadService.RestoreAsync(actividad.Id);
            await GetActividades();

            await _sweetAlert.FireAsync(
                "Restaurada",
                "La actividad fue restaurada exitosamente.",
                SweetAlertIcon.Success);
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al restaurar la actividad.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}