@page "/admin/profesores"
@inject IGenericService<Profesor> _profesorService
@inject SweetAlertService _sweetAlert
@rendermode InteractiveServer

@if (profesores == null)
{
    <div class="d-flex align-items-center justify-content-center min-vh-50 py-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        @* --- 1. Encabezado --- *@
        <EncabezadoPage Titulo="Administración de Profesores" Descripcion="Gestiona los profesores disponibles para las actividades" />

        @* --- 2. Filtro arriba en el centro --- *@
        <div class="mx-auto mb-4" style="max-width:500px;">
            <div class="search-box-container mb-4">
                <div class="input-group search-input-group">
                    <span class="input-group-text bg-transparent border-end-0 px-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input id="filterText"
                           type="text"
                           class="form-control border-start-0 ps-2"
                           value="@filterText"
                           @oninput="FilterList"
                           placeholder="Filtrar por apellido y nombre del profesor..." />
                </div>
            </div>
        </div>

        @* --- 3. Resultados de búsqueda en el medio --- *@
        <div class="row mb-3">
            <div class="col-12">
                <ResultadoBusqueda Cantidad="profesoresFiltrados.Count" TextoResultado="@(profesoresFiltrados.Count == 1 ? "profesor encontrado" : "profesores encontrados")" />

                @* Estado sin resultados *@
                @if (profesoresFiltrados.Count == 0 && !isLoading)
                {
                    <div class="card shadow-sm border-0 rounded-3 my-2 bg-light">
                        <div class="card-body text-center py-3 px-3">
                            <div class="mb-1">
                                <i class="bi bi-search text-muted" style="font-size: 1.25rem;"></i>
                            </div>
                            <p class="text-secondary small mb-0">
                                @(MostrarEliminados ? "No hay profesores eliminados." : "No hay profesores registrados.")
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* --- 4. Botón Nuevo y Ver eliminados antes de la tabla --- *@
        <div class="mb-4">
            <SeccionBtnNuevoMostrarEliminados TargetModal="#NuevoEditarProfesor"
                                              @bind-MostrarEliminados="MostrarEliminados"
                                              OnAfterMostrarEliminados="GetProfesores"
                                              OnNuevo="Nuevo" />
        </div>

        @* --- 5. Tabla de profesores --- *@
        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Actualizando...</span>
                </div>
            </div>
        }
        else if (profesoresFiltrados != null && profesoresFiltrados.Count > 0)
        {
            <TablaProfesorConFiltro ListEntity="profesoresFiltrados"
                                    OnEliminar="Eliminar"
                                    OnModificar="Modificar"
                                    OnRestaurar="Restaurar"
                                    MostrarEliminados="MostrarEliminados" />
        }
    </div>
}

<NuevoEditarProfesor Profesor="@profesorCurrent"
                     OnGuardar="Guardar" />

@code {
    List<Profesor>? profesores = null;
    List<Profesor> profesoresFiltrados = new();
    Profesor profesorCurrent = new();
    string filterText = "";

    bool isLoading = true;

    public bool MostrarEliminados { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetProfesores();
    }

    private async Task GetProfesores()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            profesores = MostrarEliminados
                ? await _profesorService.GetAllDeletedsAsync() ?? new List<Profesor>()
                : await _profesorService.GetAllAsync() ?? new List<Profesor>();

            AplicarFiltro(filterText);
        }
        catch
        {
            profesores = new List<Profesor>();
            profesoresFiltrados = new List<Profesor>();
            await _sweetAlert.FireAsync(
                "Error",
                "No se pudieron cargar los profesores.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void FilterList(ChangeEventArgs e)
    {
        filterText = e.Value?.ToString() ?? "";
        AplicarFiltro(filterText);
    }

    private void AplicarFiltro(string texto)
    {
        filterText = texto;

        if (profesores is null)
        {
            profesoresFiltrados = new();
            return;
        }

        if (string.IsNullOrWhiteSpace(filterText))
        {
            profesoresFiltrados = profesores
                .OrderBy(p => p.Nombre != null ? p.Nombre.Trim() : string.Empty, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
            return;
        }

        profesoresFiltrados = profesores
            .Where(p => p.Nombre != null && p.Nombre.Contains(filterText, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Nombre != null ? p.Nombre.Trim() : string.Empty, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    private void Modificar(Profesor profesor)
    {
        profesorCurrent = profesor;
        StateHasChanged();
    }

    private void Nuevo()
    {
        profesorCurrent = new Profesor();
    }

    private async Task Eliminar(Profesor profesor)
    {
        var respuesta = await _sweetAlert.FireAsync(new SweetAlertOptions
        {
            Title = "Eliminando profesor",
            Text = $"¿Está seguro que desea eliminar al profesor {profesor.Nombre}?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (!respuesta.IsConfirmed)
            return;

        try
        {
            isLoading = true;

            await _profesorService.DeleteAsync(profesor.Id);
            await GetProfesores();

            await _sweetAlert.FireAsync(
                "Eliminado",
                "El profesor fue eliminado exitosamente.",
                SweetAlertIcon.Success);
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al eliminar el profesor.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Guardar(Profesor profesorToSave)
    {
        try
        {
            isLoading = true;

            if (profesorToSave.Id == 0)
            {
                await _profesorService.AddAsync(profesorToSave);

                await _sweetAlert.FireAsync(
                    "Creado",
                    "El profesor fue creado exitosamente.",
                    SweetAlertIcon.Success);
            }
            else
            {
                await _profesorService.UpdateAsync(profesorToSave);

                await _sweetAlert.FireAsync(
                    "Actualizado",
                    "El profesor fue actualizado exitosamente.",
                    SweetAlertIcon.Success);
            }

            await GetProfesores();
            profesorCurrent = new Profesor();
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al guardar el profesor.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Restaurar(Profesor profesor)
    {
        var respuesta = await _sweetAlert.FireAsync(new SweetAlertOptions
        {
            Title = "Restaurando profesor",
            Text = $"¿Está seguro que desea restaurar al profesor {profesor.Nombre}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, restaurar",
            CancelButtonText = "Cancelar"
        });

        if (!respuesta.IsConfirmed)
            return;

        try
        {
            isLoading = true;

            await _profesorService.RestoreAsync(profesor.Id);
            await GetProfesores();

            await _sweetAlert.FireAsync(
                "Restaurado",
                "El profesor fue restaurado exitosamente.",
                SweetAlertIcon.Success);
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al restaurar el profesor.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}