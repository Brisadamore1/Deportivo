@page "/admin/profesores"
@using Service.Interfaces
@using Service.Models
@using Web.Components.Commons

@inject IGenericService<Profesor> _profesorService
@inject SweetAlertService _sweetAlert
@rendermode InteractiveServer

<EncabezadoPage Titulo="Administración de Profesores" Descripcion="Gestiona los profesores" />

<div class="container py-4">
    <SeccionBtnNuevoMostrarEliminados TargetModal="#NuevoEditarProfesor"
                                      @bind-MostrarEliminados="MostrarEliminados"
                                      OnAfterMostrarEliminados="GetProfesores"
                                      OnNuevo="Nuevo" />

    @if (isLoading)
    {
        <ActivityIndicator Mensaje="Cargando profesores..." IsBusy="isLoading" />
    }
    else
    {
        @if (profesores != null && profesores.Count > 0)
        {
            <TablaProfesorConFiltro ListEntity="profesores"
                                    OnEliminar="Eliminar"
                                    OnModificar="Modificar"
                                    OnRestaurar="Restaurar"
                                    MostrarEliminados="MostrarEliminados" />
        }
        else
        {
            @if (MostrarEliminados)
            {
                <div class="alert alert-info" role="alert">
                    No hay profesores eliminados.
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    No hay profesores registrados.
                </div>
            }
        }
    }

    <NuevoEditarProfesor Profesor="@profesorCurrent"
                         OnGuardar="Guardar" />
</div>

@code {
    List<Profesor>? profesores = new();
    Profesor profesorCurrent = new();

    bool isLoading = true;

    public bool MostrarEliminados { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetProfesores();
    }

    private async Task GetProfesores()
    {
        isLoading = true;

        try
        {
            profesores = MostrarEliminados
                ? await _profesorService.GetAllDeletedsAsync()
                : await _profesorService.GetAllAsync();
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "No se pudieron cargar los profesores.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Modificar(Profesor profesor)
    {
        profesorCurrent = profesor;
    }

    private void Nuevo()
    {
        profesorCurrent = new Profesor();
    }

    private async Task Eliminar(Profesor profesor)
    {
        var respuesta = await _sweetAlert.FireAsync(new SweetAlertOptions
        {
            Title = "Eliminando profesor",
            Text = $"¿Está seguro que desea eliminar al profesor {profesor.Nombre}?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (!respuesta.IsConfirmed)
            return;

        try
        {
            isLoading = true;

            await _profesorService.DeleteAsync(profesor.Id);
            await GetProfesores();

            await _sweetAlert.FireAsync(
                "Eliminada",
                "El profesor fue eliminada exitosamente.",
                SweetAlertIcon.Success);
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al eliminar al profesor.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Guardar(Profesor profesorToSave)
    {
        try
        {
            isLoading = true;

            if (profesorToSave.Id == 0)
            {
                await _profesorService.AddAsync(profesorToSave);

                await _sweetAlert.FireAsync(
                    "Creada",
                    "El profesor fue creado exitosamente.",
                    SweetAlertIcon.Success);
            }
            else
            {
                await _profesorService.UpdateAsync(profesorToSave);

                await _sweetAlert.FireAsync(
                    "Actualizada",
                    "El profesor fue actualizado exitosamente.",
                    SweetAlertIcon.Success);
            }

            await GetProfesores();
            profesorCurrent = new Profesor();
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al guardar al profesor.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Restaurar(Profesor profesor)
    {
        var respuesta = await _sweetAlert.FireAsync(new SweetAlertOptions
        {
            Title = "Restaurando profesor",
            Text = $"¿Está seguro que desea restaurar al profesor {profesor.Nombre}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, restaurar",
            CancelButtonText = "Cancelar"
        });

        if (!respuesta.IsConfirmed)
            return;

        try
        {
            isLoading = true;

            await _profesorService.RestoreAsync(profesor.Id);
            await GetProfesores();

            await _sweetAlert.FireAsync(
                "Restaurada",
                "El profesor fue restaurado exitosamente.",
                SweetAlertIcon.Success);
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al restaurar al profesor.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}