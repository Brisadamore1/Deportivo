@page "/admin/socios"
@inject NavigationManager _navigationManager
@inject ISocioService _socioService
@inject SweetAlertService _sweetAlert
@rendermode InteractiveServer

@if (socios == null)
{
    <div class="d-flex align-items-center justify-content-center min-vh-50 py-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        @* --- 1. Encabezado --- *@
        <EncabezadoPage Titulo="Administración de Socios" Descripcion="Gestiona los socios del club deportivo" />

        @* --- 2. Filtro arriba (ÚNICO buscador) --- *@
        <div class="mx-auto mb-4" style="max-width:500px;">
            <div class="search-box-container mb-4">
                <div class="input-group search-input-group">
                    <span class="input-group-text bg-transparent border-end-0 px-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input id="filterText"
                           type="text"
                           class="form-control border-start-0 ps-2"
                           value="@filterText"
                           @oninput="FilterList"
                           placeholder="Filtrar por nombre, DNI, localidad o actividad..." />
                </div>
            </div>
        </div>

        @* --- 3. Resultados de búsqueda en el medio --- *@
        <div class="row mb-3">
            <div class="col-12">
                <ResultadoBusqueda Cantidad="sociosFiltrados.Count" TextoResultado="@(sociosFiltrados.Count == 1 ? "socio encontrado" : "socios encontrados")" />

                @* Estado sin resultados (Compacto y chico) *@
                @if (sociosFiltrados.Count == 0 && !isLoading)
                {
                    <div class="card shadow-sm border-0 rounded-3 my-2 bg-light">
                        <div class="card-body text-center py-3 px-3">
                            <div class="mb-1">
                                <i class="bi bi-search text-muted" style="font-size: 1.25rem;"></i>
                            </div>
                            <p class="text-secondary small mb-0">
                                @(MostrarEliminados ? "No hay socios eliminados." : "No hay socios registrados.")
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* --- 4. Botón Nuevo y Ver eliminados antes de la tabla --- *@
        <div class="mb-4">
            <SeccionBtnNuevoMostrarEliminados TargetModal="#NuevoEditarSocio"
                                              @bind-MostrarEliminados="MostrarEliminados"
                                              OnAfterMostrarEliminados="GetSocios"
                                              OnNuevo="Nuevo" />
        </div>

        @* --- 5. Tabla de socios (Renderiza el spinner pequeño al actualizar o la tabla completa) --- *@
        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Actualizando...</span>
                </div>
            </div>
        }
        else if (sociosFiltrados != null && sociosFiltrados.Count > 0)
        {
            <TablaSociosConFiltro ListEntity="sociosFiltrados"
                                  OnEliminar="Eliminar"
                                  OnModificar="Modificar"
                                  OnGuardar="Guardar"
                                  OnRestaurar="Restaurar"
                                  MostrarEliminados="MostrarEliminados" />
        }
    </div>
}

<NuevoEditarSocio Socio="@socioCurrent"
                  OnGuardar="Guardar" />

@code {
    List<Socio>? socios = null;
    List<Socio> sociosFiltrados = new();
    Socio socioCurrent = new();
    string filterText = "";

    bool isLoading = true;

    public bool MostrarEliminados { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetSocios();
    }

    private async Task GetSocios()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            socios = MostrarEliminados
                ? await _socioService.GetAllDeletedsAsync() ?? new List<Socio>()
                : await _socioService.GetAllAsync() ?? new List<Socio>();

            AplicarFiltro(filterText);
        }
        catch
        {
            socios = new List<Socio>();
            sociosFiltrados = new List<Socio>();
            await _sweetAlert.FireAsync(
                "Error",
                "No se pudieron cargar los socios.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void FilterList(ChangeEventArgs e)
    {
        filterText = e.Value?.ToString() ?? "";
        AplicarFiltro(filterText);
    }

    private void AplicarFiltro(string texto)
    {
        filterText = texto;

        if (socios is null)
        {
            sociosFiltrados = new();
            return;
        }

        if (string.IsNullOrWhiteSpace(filterText))
        {
            sociosFiltrados = socios.ToList();
            return;
        }

        sociosFiltrados = socios
            .Where(a =>
                (a.Nombre?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Dni?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Localidad?.Nombre?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.SocioActividades?.Any(sa => sa.Actividad != null && (sa.Actividad.Nombre?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false)) ?? false))
            .ToList();
    }

    private void Modificar(Socio socio)
    {
        socioCurrent = socio;
        StateHasChanged();
    }

    private void Nuevo()
    {
        socioCurrent = new Socio();
    }

    private async Task Eliminar(Socio socio)
    {
        var respuesta = await _sweetAlert.FireAsync(new SweetAlertOptions
        {
            Title = "Eliminando socio",
            Text = $"¿Está seguro que desea eliminar al socio {socio.Nombre}?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (!respuesta.IsConfirmed)
            return;

        try
        {
            isLoading = true;

            await _socioService.DeleteAsync(socio.Id);
            await GetSocios();

            await _sweetAlert.FireAsync(
                "Eliminado",
                "El socio ha sido eliminado exitosamente.",
                SweetAlertIcon.Success);
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al eliminar el socio.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Guardar(Socio socioToSave)
    {
        try
        {
            isLoading = true;

            if (socioToSave.Id == 0)
            {
                await _socioService.AddAsync(socioToSave);

                await _sweetAlert.FireAsync(
                    "Creado",
                    "El socio ha sido creado exitosamente.",
                    SweetAlertIcon.Success);
            }
            else
            {
                await _socioService.UpdateAsync(socioToSave);

                await _sweetAlert.FireAsync(
                    "Actualizado",
                    "El socio ha sido actualizado exitosamente.",
                    SweetAlertIcon.Success);
            }

            await GetSocios();
            socioCurrent = new Socio();
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al guardar el socio.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Restaurar(Socio socio)
    {
        var respuesta = await _sweetAlert.FireAsync(new SweetAlertOptions
        {
            Title = "Restaurando socio",
            Text = $"¿Está seguro que desea restaurar al socio {socio.Nombre}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, restaurar",
            CancelButtonText = "Cancelar"
        });

        if (!respuesta.IsConfirmed)
            return;

        try
        {
            isLoading = true;

            await _socioService.RestoreAsync(socio.Id);
            await GetSocios();

            await _sweetAlert.FireAsync(
                "Restaurado",
                "El socio ha sido restaurado exitosamente.",
                SweetAlertIcon.Success);
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al restaurar el socio.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}