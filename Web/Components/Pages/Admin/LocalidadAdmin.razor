@page "/admin/localidades"
@inject IGenericService<Localidad> _localidadService
@inject SweetAlertService _sweetAlert
@rendermode InteractiveServer

<EncabezadoPage Titulo="Administración de Localidades"
                Descripcion="Gestiona las localidades disponibles para los socios" />

<div class="container py-4">
    <SeccionBtnNuevoMostrarEliminados
        @bind-MostrarEliminados="MostrarEliminados"
        OnAfterMostrarEliminados="GetLocalidades"
        OnNuevo="Nuevo" />

    @if (isLoading)
    {
        <ActivityIndicator Mensaje="Cargando localidades..." IsBusy="isLoading" />
    }
    else
    {
        @if (localidades != null && localidades.Count > 0)
        {
            <TablaLocalidadConFiltro
                ListEntity="localidades"
                OnEliminar="Eliminar"
                OnModificar="Modificar"
                OnRestaurar="Restaurar"
                MostrarEliminados="MostrarEliminados" />
        }
        else
        {
            @if (MostrarEliminados)
            {
                <div class="alert alert-info" role="alert">
                    No hay localidades eliminadas.
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    No hay localidades registradas.
                </div>
            }
        }
    }

    <NuevoEditarLocalidad
        Localidad="@localidadCurrent"
        OnGuardar="Guardar" />
</div>

@code {
    List<Localidad>? localidades = new();
    Localidad localidadCurrent = new();

    bool isLoading = true;

    public bool MostrarEliminados { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetLocalidades();
    }

    private async Task GetLocalidades()
    {
        isLoading = true;

        try
        {
            localidades = MostrarEliminados
                ? await _localidadService.GetAllDeletedsAsync()
                : await _localidadService.GetAllAsync();
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "No se pudieron cargar las localidades.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Modificar(Localidad localidad)
    {
        localidadCurrent = localidad;
    }

    private void Nuevo()
    {
        localidadCurrent = new Localidad();
    }

    private async Task Eliminar(Localidad localidad)
    {
        var respuesta = await _sweetAlert.FireAsync(new SweetAlertOptions
        {
            Title = "Eliminando localidad",
            Text = $"¿Está seguro que desea eliminar la localidad {localidad.Nombre}?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (!respuesta.IsConfirmed)
            return;

        try
        {
            isLoading = true;

            await _localidadService.DeleteAsync(localidad.Id);
            await GetLocalidades();

            await _sweetAlert.FireAsync(
                "Eliminada",
                "La localidad fue eliminada exitosamente.",
                SweetAlertIcon.Success);
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al eliminar la localidad.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Guardar(Localidad localidadToSave)
    {
        try
        {
            isLoading = true;

            if (localidadToSave.Id == 0)
            {
                await _localidadService.AddAsync(localidadToSave);

                await _sweetAlert.FireAsync(
                    "Creada",
                    "La localidad fue creada exitosamente.",
                    SweetAlertIcon.Success);
            }
            else
            {
                await _localidadService.UpdateAsync(localidadToSave);

                await _sweetAlert.FireAsync(
                    "Actualizada",
                    "La localidad fue actualizada exitosamente.",
                    SweetAlertIcon.Success);
            }

            await GetLocalidades();
            localidadCurrent = new Localidad();
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al guardar la localidad.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Restaurar(Localidad localidad)
    {
        var respuesta = await _sweetAlert.FireAsync(new SweetAlertOptions
        {
            Title = "Restaurando localidad",
            Text = $"¿Está seguro que desea restaurar la localidad {localidad.Nombre}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, restaurar",
            CancelButtonText = "Cancelar"
        });

        if (!respuesta.IsConfirmed)
            return;

        try
        {
            isLoading = true;

            await _localidadService.RestoreAsync(localidad.Id);
            await GetLocalidades();

            await _sweetAlert.FireAsync(
                "Restaurada",
                "La localidad fue restaurada exitosamente.",
                SweetAlertIcon.Success);
        }
        catch
        {
            await _sweetAlert.FireAsync(
                "Error",
                "Hubo un error al restaurar la localidad.",
                SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}