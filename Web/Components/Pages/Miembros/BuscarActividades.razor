@page "/miembros/buscar-actividades"
@inject IActivityService _actividadService
@inject FirebaseAuthService firebaseAuthService
@rendermode InteractiveServer

@if (Actividades == null)
{
    <div class="d-flex align-items-center justify-content-center min-vh-50 py-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="container py-4">

        <EncabezadoPage Titulo="Buscar Actividades"
                        Descripcion="Encuentra actividades registradas en el sistema" />

        <div class="mx-auto mb-4" style="max-width:500px;">
              <SeccionBusquedaActividades OnBuscar="Buscar" />
        </div>

        <div class="row">
            <div class="col-12">

                <ResultadoBusqueda Cantidad="Actividades.Count"
                                   TextoResultado="@(Actividades.Count == 1 ? "actividad encontrada" : "actividades encontradas")" />

                @if (Actividades.Count == 0 && !IsBusy)
                {
                    <div class="card shadow-sm border-0 rounded-4 my-3 bg-light">
                        <div class="card-body text-center py-5 px-4">
                            <div class="mb-3">
                                <i class="bi bi-search text-muted" style="font-size:2.5rem;"></i>
                            </div>

                            <h5 class="fw-bold text-dark mb-2">
                                Sin resultados
                            </h5>

                            <p class="text-secondary mb-2">
                                Intenta con otros términos de búsqueda o ajusta los filtros seleccionados.
                            </p>

                            <small class="text-muted d-block">
                                <i class="bi bi-lightbulb me-1 text-warning"></i>
                                <strong>Tip:</strong> Busca por nombre de la actividad.
                            </small>
                        </div>
                    </div>
                }

                <div class="container-fluid px-0">
                    @foreach (var actividad in Actividades)
                    {
                        <div class="row w-100 m-0">
                            <div class="col-12 px-0">
                                <CardActividad Actividad="actividad" />
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>

    </div>
}

@code {

    List<Actividad>? Actividades { get; set; } = new();

    bool IsBusy { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Buscar("");
        }
    }

    async Task Buscar(string texto)
    {
        IsBusy = true;
        StateHasChanged();

        try
        {
            FilterActivityDTO filtro = new()
            {
                SearchText = texto,
                ForNombre = true,
                ForProfesor = true,
                ForNivel = true
            };

            Actividades = await _actividadService.GetWithFilterAsync(filtro)
                          ?? new List<Actividad>();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Actividades = new();
        }
        finally
        {
            IsBusy = false;
            StateHasChanged();
        }
    }

}