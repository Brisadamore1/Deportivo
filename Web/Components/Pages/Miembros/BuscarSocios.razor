@page "/miembros/buscar-socios"
@inject ISocioService _socioService
@inject FirebaseAuthService firebaseAuthService
@rendermode InteractiveServer

@if (Socios == null)
{
    <div class="d-flex align-items-center justify-content-center min-vh-50 py-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        @* --- Encabezado --- *@
        <EncabezadoPage Titulo="Buscar Socios" Descripcion="Encuentra socios registrados en el sistema" />

        @* --- Sección de búsqueda --- *@
        <div class="card table-card shadow-sm border-0 mb-4 rounded-4">
            <div class="card-body p-3 p-md-4">
                <SeccionBusqueda Socios="Socios" OnBuscar="Buscar" />
            </div>
        </div>

        @* --- Sección de resultados --- *@
        <div class="row">
            <div class="col-12">
                <!-- Indicador de cantidad de resultados -->
                <ResultadoBusqueda Cantidad="Socios.Count" TextoResultado="@(Socios.Count == 1 ? "socio encontrado" : "socios encontrados")" />

                <!-- Estado sin resultados -->
                @if (Socios.Count == 0 && !IsBusy)
                {
                    <div class="card shadow-sm border-0 rounded-4 my-3 bg-light">
                        <div class="card-body text-center py-5 px-4">
                            <div class="mb-3">
                                <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">Sin resultados</h5>
                            <p class="text-secondary mb-2">
                                Intenta con otros términos de búsqueda o ajusta los filtros seleccionados.
                            </p>
                            <small class="text-muted d-block">
                                <i class="bi bi-lightbulb me-1 text-warning"></i>
                                <strong>Tip:</strong> Usa palabras clave simples como el DNI o el apellido.
                            </small>
                        </div>
                    </div>
                }

                <!-- Grilla / Lista de Tarjetas de Socios -->
                <div class="container-fluid px-0">
                    @foreach (var socio in Socios)
                    {
                        <div class="row w-100 m-0">
                            <div class="col-12 px-0">
                                <CardSocio socio="socio" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
@code {
    // Resultados
    List<Socio>? Socios { get; set; } = new();
    bool IsBusy { get; set; } = false;

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            // Cargar datos iniciales si es necesario
            IsBusy = true;
            StateHasChanged();
            await Buscar(new FilterSocioDTO(){ForNombre=true});
        }
    }

    async Task Buscar(FilterSocioDTO filterDTO)
    {
        IsBusy = true;
        StateHasChanged();

        try
        {
            Socios = await _socioService.GetWithFilterAsync(filterDTO)
                     ?? new List<Socio>();
        }
        catch (Exception ex)
        {
            Socios = new List<Socio>();

            // Por ahora permite ver el error exacto en la página.
            Console.WriteLine($"Error al buscar socios: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
            StateHasChanged();
        }
    }
}