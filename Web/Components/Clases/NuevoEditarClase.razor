@inject IActivityService _actividadService

<div class="modal fade" id="NuevoEditarClase" tabindex="-1"
     aria-labelledby="tituloModalClase" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content custom-modal-content">

            <EditForm Model="@Clase" OnValidSubmit="HandleGuardar">
                <DataAnnotationsValidator />

                <!-- CABECERA -->
                <div class="modal-header custom-modal-header text-white py-2 px-3">
                    <div>
                        <h6 class="modal-title fw-bold mb-0" id="tituloModalClase">
                            @(Clase?.Id > 0 ? "Editar clase" : "Nueva clase")
                        </h6>
                        <small class="modal-subtitle opacity-75">
                            Complete los detalles del horario y capacidad
                        </small>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <!-- CUERPO -->
                <div class="modal-body p-3">
                    <div class="row g-3">

                        <!-- ACTIVIDAD -->
                        <div class="col-md-6">
                            <label for="actividadInput" class="custom-form-label">
                                Actividad <span class="text-danger">*</span>
                            </label>

                            <InputSelect id="actividadInput"
                                         class="form-select custom-form-input"
                                         @bind-Value="Clase.ActividadId">
                                <option value="0">Seleccione una actividad</option>

                                @foreach (var actividad in actividades)
                                {
                                    <option value="@actividad.Id">
                                        @actividad.Nombre
                                    </option>
                                }
                            </InputSelect>

                            <ValidationMessage For="@(() => Clase.ActividadId)"
                                               class="text-danger small mt-1" />
                        </div>

                        <!-- DÍA -->
                        <div class="col-md-6">
                            <label for="diaInput" class="custom-form-label">
                                Día de la semana <span class="text-danger">*</span>
                            </label>

                            <InputSelect id="diaInput"
                                         class="form-select custom-form-input"
                                         @bind-Value="Clase.DiaSemana">

                                @foreach (var dia in Enum.GetValues<DayOfWeek>())
                                {
                                    <option value="@dia">
                                        @NombreDia(dia)
                                    </option>
                                }

                            </InputSelect>
                        </div>

                        <!-- HORA INICIO -->
                        <div class="col-md-4">
                            <label for="horaInicioInput" class="custom-form-label">
                                Hora de inicio <span class="text-danger">*</span>
                            </label>

                            <input id="horaInicioInput"
                                   type="time"
                                   class="form-control custom-form-input"
                                   @bind="HoraInicioInput" />

                            <ValidationMessage For="@(() => Clase.HoraInicio)"
                                               class="text-danger small mt-1" />
                        </div>

                        <!-- HORA FIN -->
                        <div class="col-md-4">
                            <label for="horaFinInput" class="custom-form-label">
                                Hora de finalización <span class="text-danger">*</span>
                            </label>

                            <input id="horaFinInput"
                                   type="time"
                                   class="form-control custom-form-input"
                                   @bind="HoraFinInput" />

                            <ValidationMessage For="@(() => Clase.HoraFin)"
                                               class="text-danger small mt-1" />
                        </div>

                        <!-- CUPO -->
                        <div class="col-md-4">
                            <label for="cupoInput" class="custom-form-label">
                                Cupo máximo
                            </label>

                            <InputNumber id="cupoInput"
                                         class="form-control custom-form-input"
                                         @bind-Value="Clase.CupoMaximo" />

                            <ValidationMessage For="@(() => Clase.CupoMaximo)"
                                               class="text-danger small mt-1" />
                        </div>

                        <!-- ACTIVA -->
                        <div class="col-12 mt-2">
                            <div class="form-check form-switch pt-1">
                                <InputCheckbox id="activaInput"
                                               class="form-check-input"
                                               @bind-Value="Clase.Activa" />

                                <label for="activaInput"
                                       class="form-check-label fw-semibold text-dark">
                                    Clase activa
                                </label>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- BOTONES -->
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button"
                            class="btn btn-outline-secondary px-4 rounded-3 fw-semibold"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-action-primary px-4 fw-semibold">
                        Guardar cambios
                    </button>
                </div>

            </EditForm>

        </div>
    </div>
</div>

@code {

    [Parameter]
    public Clase Clase { get; set; } = new();

    [Parameter]
    public EventCallback<Clase> OnGuardar { get; set; }

    private List<Actividad> actividades = new();

    private TimeOnly HoraInicioInput
    {
        get => TimeOnly.FromTimeSpan(Clase.HoraInicio);

        set
        {
            Clase.HoraInicio = value.ToTimeSpan();
        }
    }

    private TimeOnly HoraFinInput
    {
        get => TimeOnly.FromTimeSpan(Clase.HoraFin);

        set
        {
            Clase.HoraFin = value.ToTimeSpan();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        actividades = await _actividadService.GetAllAsync()
                      ?? new List<Actividad>();
    }

    private async Task HandleGuardar()
    {
        if (OnGuardar.HasDelegate)
        {
            await OnGuardar.InvokeAsync(Clase);
        }
    }

    private static string NombreDia(DayOfWeek dia)
    {
        return dia switch
        {
            DayOfWeek.Monday => "Lunes",
            DayOfWeek.Tuesday => "Martes",
            DayOfWeek.Wednesday => "Miércoles",
            DayOfWeek.Thursday => "Jueves",
            DayOfWeek.Friday => "Viernes",
            DayOfWeek.Saturday => "Sábado",
            DayOfWeek.Sunday => "Domingo",
            _ => dia.ToString()
        };
    }
}