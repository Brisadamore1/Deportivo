@if (sociosFiltrados is null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="text-muted mt-2">Cargando datos...</p>
    </div>
}
else
{
    <!-- BUSCADOR -->
    <div class="search-box-container mb-4">
        <div class="input-group search-input-group">
            <span class="input-group-text bg-transparent border-end-0 pe-0">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input id="filterText"
                   type="text"
                   class="form-control border-start-0 ps-2"
                   value="@filterText"
                   @oninput="FilterList"
                   placeholder="Filtrar por nombre, DNI o localidad..." />
        </div>
    </div>

    <!-- TABLA EN TARJETA -->
    <div class="table-card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table custom-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">Id</th>
                        <th>Nombre</th>
                        <th>DNI</th>
                        <th>Localidad</th>
                        <th class="text-center">Actividades</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" style="width: 180px;">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var socio in sociosFiltrados)
                    {
                        <tr @key="socio.Id">
                            <td class="fw-bold text-muted">#@socio.Id</td>
                            <td class="fw-semibold text-dark">@socio.Nombre</td>
                            <td>@socio.Dni</td>
                            <td>@(socio.Localidad?.Nombre ?? "-")</td>

                            <!-- BOTÓN ACTIVIDADES -->
                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-outline-custom-secondary btn-sm rounded-pill"
                                        data-bs-toggle="modal"
                                        data-bs-target="#EditarActividadSocio"
                                        @onclick="() => SeleccionarSocio(socio)">
                                    <i class="bi bi-list-check me-1"></i> Actividades
                                </button>
                            </td>

                            <!-- ESTADO BADGE -->
                            <td class="text-center">
                                @if (socio.Activo)
                                {
                                    <span class="badge badge-pastel-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-pastel-secondary">Inactivo</span>
                                }
                            </td>

                            <!-- ACCIONES -->
                            <td class="text-center">
                                @if (MostrarEliminados)
                                {
                                    <button type="button"
                                            title="Restaurar socio"
                                            class="btn btn-custom-success btn-sm me-1"
                                            @onclick="() => HandleRestaurar(socio)">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Restaurar
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            title="Modificar socio"
                                            class="btn btn-custom-edit btn-sm me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#NuevoEditarSocio"
                                            @onclick="() => HandleModificarDatosSocio(socio)">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>

                                    <button type="button"
                                            title="Eliminar socio"
                                            class="btn btn-custom-danger btn-sm"
                                            @onclick="() => HandleEliminar(socio)">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Componente para el modal de Actividades -->
<EditarActividadSocio Socio="socioSeleccionado" OnGuardar="HandleGuardarActividades" />

@code {
    [Parameter]
    public List<Socio> ListEntity { get; set; } = new();

    [Parameter]
    public bool MostrarEliminados { get; set; }

    [Parameter]
    public EventCallback<Socio> OnModificar { get; set; }

    [Parameter]
    public EventCallback<Socio> OnGuardar { get; set; }

    [Parameter]
    public EventCallback<Socio> OnEliminar { get; set; }

    [Parameter]
    public EventCallback<Socio> OnRestaurar { get; set; }

    private List<Socio> sociosFiltrados = new();
    private string filterText = string.Empty;
    private Socio socioSeleccionado = new();

    protected override void OnParametersSet()
    {
        AplicarFiltro();
    }

    private void SeleccionarSocio(Socio socio)
    {
        socioSeleccionado = socio;
    }

    private void HandleModificarDatosSocio(Socio socio)
    {
        // Se ejecuta sincrónicamente antes de que el modal se renderice por completo
        if (OnModificar.HasDelegate)
        {
            OnModificar.InvokeAsync(socio);
        }
    }

    private async Task HandleGuardarActividades(Socio socioModificado)
    {
        await OnGuardar.InvokeAsync(socioModificado);
    }

    private async Task HandleEliminar(Socio socio)
    {
        await OnEliminar.InvokeAsync(socio);
    }

    private async Task HandleRestaurar(Socio socio)
    {
        await OnRestaurar.InvokeAsync(socio);
    }

    private void FilterList(ChangeEventArgs e)
    {
        filterText = e.Value?.ToString() ?? string.Empty;
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(filterText))
        {
            sociosFiltrados = ListEntity.ToList();
            return;
        }

        sociosFiltrados = ListEntity
            .Where(s =>
                s.Nombre.Contains(filterText, StringComparison.OrdinalIgnoreCase) ||
                s.Dni.Contains(filterText, StringComparison.OrdinalIgnoreCase) ||
                (s.Localidad?.Nombre?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();
    }
}