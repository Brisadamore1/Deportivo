@using Service.Interfaces
@using Service.Models
@inject IGenericService<Actividad> _actividadService

<div class="modal fade" id="EditarActividadSocio" tabindex="-1"
     aria-labelledby="tituloActividadSocio" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal-content">

            <!-- CABECERA DEGRADÉ AZUL -->
            <div class="modal-header custom-modal-header text-white">
                <div>
                    <h5 class="modal-title fw-bold" id="tituloActividadSocio">
                        Actividades de @(Socio?.Nombre ?? "Socio")
                    </h5>
                    <p class="modal-subtitle mb-0 opacity-75">Gestiona sus inscripciones</p>
                </div>

                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>

            <!-- CUERPO DEL MODAL -->
            <div class="modal-body p-4">
                @if (cargando)
                {
                    <div class="d-flex align-items-center justify-content-center py-4 gap-2 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span>Cargando actividades...</span>
                    </div>
                }
                else
                {
                    <!-- 1. LISTA DE ACTIVIDADES INSCRIPTAS -->
                    <div class="mb-4">
                        @if (Socio?.SocioActividades == null || !Socio.SocioActividades.Any())
                        {
                            <div class="empty-state-card text-center my-2 py-3">
                                <i class="bi bi-info-circle me-1"></i> El socio no tiene actividades asignadas.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var sa in Socio.SocioActividades)
                                {
                                    var actividad = ObtenerActividadPorId(sa.ActividadId);
                                    if (actividad != null)
                                    {
                                        <div class="activity-item-card d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                <span class="fw-semibold text-dark">@actividad.Nombre</span>
                                            </div>

                                            <button type="button"
                                                    class="btn btn-custom-danger btn-sm d-inline-flex align-items-center gap-1"
                                                    @onclick="() => EliminarActividad(sa.ActividadId)">
                                                <i class="bi bi-trash-fill"></i> Baja
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <hr class="my-3 divider-line" />

                    <!-- 2. DESPLEGABLE PARA AGREGAR NUEVA ACTIVIDAD -->
                    <div class="row g-2 align-items-center mt-2">
                        <div class="col">
                            <select class="form-select custom-form-select" @bind="actividadSeleccionadaId">
                                <option value="0" disabled selected>Agregar actividad...</option>
                                @foreach (var act in ObtenerActividadesDisponiblesParaInscribir())
                                {
                                    <option value="@act.Id">@act.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="button"
                                    class="btn btn-action-primary px-3"
                                    disabled="@(actividadSeleccionadaId == 0)"
                                    @onclick="InscribirActividad">
                                Inscribir
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- PIE DE PÁGINA / BOTONES -->
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-outline-secondary px-4 rounded-3 fw-semibold"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button" class="btn btn-action-primary px-4 fw-semibold"
                        data-bs-dismiss="modal"
                        @onclick="HandleGuardar">
                    Guardar cambios
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public Socio Socio { get; set; } = new();

    [Parameter]
    public EventCallback<Socio> OnGuardar { get; set; }

    private List<Actividad> todasLasActividades = new();
    private int actividadSeleccionadaId = 0;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        todasLasActividades = await _actividadService.GetAllAsync() ?? new List<Actividad>();
        cargando = false;
    }

    protected override void OnParametersSet()
    {
        if (Socio != null)
        {
            Socio.SocioActividades ??= new List<SocioActividad>();
        }
    }

    private Actividad? ObtenerActividadPorId(int actividadId)
    {
        return todasLasActividades.FirstOrDefault(a => a.Id == actividadId);
    }

    // Filtra el combo para que solo muestre las actividades a las que aún NO está inscripto
    private IEnumerable<Actividad> ObtenerActividadesDisponiblesParaInscribir()
    {
        if (Socio?.SocioActividades == null) return todasLasActividades;

        var idsInscriptos = Socio.SocioActividades.Select(sa => sa.ActividadId).ToList();
        return todasLasActividades.Where(a => !idsInscriptos.Contains(a.Id));
    }

    private void InscribirActividad()
    {
        if (actividadSeleccionadaId == 0 || Socio == null) return;

        Socio.SocioActividades ??= new List<SocioActividad>();

        if (!Socio.SocioActividades.Any(sa => sa.ActividadId == actividadSeleccionadaId))
        {
            Socio.SocioActividades.Add(new SocioActividad
            {
                SocioId = Socio.Id,
                ActividadId = actividadSeleccionadaId
            });
        }

        // Resetea la selección del combo
        actividadSeleccionadaId = 0;
    }

    private void EliminarActividad(int actividadId)
    {
        if (Socio?.SocioActividades == null) return;

        var item = Socio.SocioActividades.FirstOrDefault(sa => sa.ActividadId == actividadId);
        if (item != null)
        {
            Socio.SocioActividades.Remove(item);
        }
    }

    private async Task HandleGuardar()
    {
        if (OnGuardar.HasDelegate)
        {
            await OnGuardar.InvokeAsync(Socio);
        }
    }
}