<div class="modal fade" id="NuevoEditarLocalidad" tabindex="-1"
     aria-labelledby="tituloModalLocalidad" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-custom-width">
        <div class="modal-content custom-modal-content">

            <!-- CABECERA -->
            <div class="modal-header custom-modal-header text-white py-2 px-3">
                <div>
                    <h6 class="modal-title fw-bold mb-0" id="tituloModalLocalidad">
                        @(Localidad?.Id > 0 ? "Editar localidad" : "Nueva localidad")
                    </h6>
                    <small class="modal-subtitle opacity-75">Complete la información de la localidad</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <!-- FORMULARIO DE BLAZOR -->
            <EditForm Model="@Localidad" OnValidSubmit="HandleGuardar">
                <DataAnnotationsValidator />

                <!-- CUERPO -->
                <div class="modal-body p-3">
                    <div class="row g-2">
                        <div class="col-12">
                            <label for="nombreInput" class="custom-form-label">
                                Nombre de la localidad <span class="text-danger">*</span>
                            </label>
                            <InputText id="nombreInput" class="form-control custom-form-input"
                                       @bind-Value="Localidad.Nombre"
                                       placeholder="Ej.: San Miguel de Tucumán" />
                            <ValidationMessage For="@(() => Localidad.Nombre)" class="text-danger small mt-1" />
                        </div>
                    </div>
                </div>

                <!-- PIE DE PÁGINA -->
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-3 fw-semibold"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-action-primary px-4 fw-semibold">
                        Guardar cambios
                    </button>
                </div>
            </EditForm>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public Localidad Localidad { get; set; } = new();

    [Parameter]
    public EventCallback<Localidad> OnGuardar { get; set; }

    private async Task HandleGuardar()
    {
        if (OnGuardar.HasDelegate)
        {
            await OnGuardar.InvokeAsync(Localidad);
        }
    }
}