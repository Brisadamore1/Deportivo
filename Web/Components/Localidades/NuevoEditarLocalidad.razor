<div class="modal fade" id="NuevoEditarModal" tabindex="-1"
     aria-labelledby="tituloModalLocalidad" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="tituloModalLocalidad">
                    Nuevo / editar localidad
                </h1>

                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-12 mb-3">
                        <label for="nombreInput" class="form-label">
                            Nombre de la localidad
                        </label>

                        <InputText id="nombreInput" class="form-control"
                                   @bind-Value="Localidad.Nombre"
                                   placeholder="Ej.: San Miguel de Tucumán" />
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button" class="btn btn-primary"
                        data-bs-dismiss="modal"
                        @onclick="HandleGuardar">
                    Guardar cambios
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Localidad Localidad { get; set; } = new();

    [Parameter]
    public EventCallback<Localidad> OnGuardar { get; set; }

    private async Task HandleGuardar()
    {
        if (OnGuardar.HasDelegate)
        {
            await OnGuardar.InvokeAsync(Localidad);
        }
    }
}