@using Service.Models

@if (localidadesFiltradas is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="form-group mb-3">
        <div class="row align-items-center g-2">
            <div class="col-auto">
                <label for="filterText" class="col-form-label mb-0">
                    Buscar
                </label>
            </div>

            <div class="col">
                <input id="filterText"
                       class="form-control"
                       value="@filterText"
                       @oninput="FilterList"
                       placeholder="Filtrar por nombre de localidad" />
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th colspan="2">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var localidad in localidadesFiltradas)
                {
                    <tr @key="localidad.Id">
                        <td>@localidad.Id</td>
                        <td>@localidad.Nombre</td>

                        @if (MostrarEliminados)
                        {
                            <td colspan="2">
                                <button type="button"
                                        title="Restaurar"
                                        class="btn btn-success"
                                        @onclick="() => HandleRestaurar(localidad)">
                                    Restaurar
                                </button>
                            </td>
                        }
                        else
                        {
                            <td>
                                <button type="button"
                                        title="Modificar"
                                        class="btn btn-info"
                                        data-bs-toggle="modal"
                                        data-bs-target="#NuevoEditarModal"
                                        @onclick="() => HandleModificar(localidad)">
                                    Modificar
                                </button>
                            </td>

                            <td>
                                <button type="button"
                                        title="Eliminar"
                                        class="btn btn-danger"
                                        @onclick="() => HandleEliminar(localidad)">
                                    Eliminar
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public List<Localidad> ListEntity { get; set; } = new();

    [Parameter]
    public bool MostrarEliminados { get; set; }

    [Parameter]
    public EventCallback<Localidad> OnModificar { get; set; }

    [Parameter]
    public EventCallback<Localidad> OnEliminar { get; set; }

    [Parameter]
    public EventCallback<Localidad> OnRestaurar { get; set; }

    private List<Localidad> localidadesFiltradas = new();
    private string filterText = string.Empty;

    protected override void OnParametersSet()
    {
        AplicarFiltro();
    }

    private async Task HandleModificar(Localidad localidad)
    {
        await OnModificar.InvokeAsync(localidad);
    }

    private async Task HandleEliminar(Localidad localidad)
    {
        await OnEliminar.InvokeAsync(localidad);
    }

    private async Task HandleRestaurar(Localidad localidad)
    {
        await OnRestaurar.InvokeAsync(localidad);
    }

    private void FilterList(ChangeEventArgs e)
    {
        filterText = e.Value?.ToString() ?? string.Empty;
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(filterText))
        {
            localidadesFiltradas = ListEntity.ToList();
            return;
        }

        localidadesFiltradas = ListEntity
            .Where(l => l.Nombre.Contains(
                filterText,
                StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}