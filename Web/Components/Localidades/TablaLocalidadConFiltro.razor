@using Service.Models

<!-- TABLA EN TARJETA -->
<div class="table-card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table custom-table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 80px;">Id</th>
                    <th>Nombre</th>
                    <th class="text-center" style="width: 180px;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var localidad in ListEntity)
                {
                    <tr @key="localidad.Id">
                        <td class="fw-bold text-muted">#@localidad.Id</td>
                        <td class="fw-semibold text-dark">@localidad.Nombre</td>

                        <!-- ACCIONES DE TABLA -->
                        <td class="text-center">
                            @if (MostrarEliminados)
                            {
                                <button type="button"
                                        title="Restaurar localidad"
                                        class="btn btn-custom-success btn-sm me-1"
                                        @onclick="() => HandleRestaurar(localidad)">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Restaurar
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        title="Modificar localidad"
                                        class="btn btn-custom-edit btn-sm me-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#NuevoEditarLocalidad"
                                        @onclick="() => HandleModificar(localidad)">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>

                                <button type="button"
                                        title="Eliminar localidad"
                                        class="btn btn-custom-danger btn-sm"
                                        @onclick="() => HandleEliminar(localidad)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public List<Localidad> ListEntity { get; set; } = new();

    [Parameter]
    public bool MostrarEliminados { get; set; }

    [Parameter]
    public EventCallback<Localidad> OnModificar { get; set; }

    [Parameter]
    public EventCallback<Localidad> OnEliminar { get; set; }

    [Parameter]
    public EventCallback<Localidad> OnRestaurar { get; set; }

    private async Task HandleModificar(Localidad localidad)
    {
        await OnModificar.InvokeAsync(localidad);
    }

    private async Task HandleEliminar(Localidad localidad)
    {
        await OnEliminar.InvokeAsync(localidad);
    }

    private async Task HandleRestaurar(Localidad localidad)
    {
        await OnRestaurar.InvokeAsync(localidad);
    }
}