<div class="row mb-4">
    <div class="col-12">
        <div class="page-header-card">
            <div class="page-header-content">
                <h2 class="page-header-title">@Titulo</h2>
                <p class="page-header-description">@Descripcion</p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Titulo { get; set; } = "Título no definido";
    [Parameter]
    public string Descripcion { get; set; } = "Descripción no definida";

}
