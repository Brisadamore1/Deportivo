<div class="card table-card shadow-sm rounded-4 mb-3 border-0 w-100" style="background-color: #f8fafc; border-left: 4px solid #274472 !important;">
    <div class="card-body py-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-search fs-5" style="color: #274472;"></i>
            <span class="fw-bold" style="color: #274472;">Resultados de búsqueda</span>
        </div>
        <div>
            <span class="fs-5 fw-bold px-3 py-1" style="color: #274472;">
                @($"{Cantidad} {TextoResultado}")
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Cantidad { get; set; } = 0;
    [Parameter]
    public string TextoResultado { get; set; } = "texto no definido";

}
