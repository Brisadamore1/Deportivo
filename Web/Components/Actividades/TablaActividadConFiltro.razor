@if (ListEntity is null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="text-muted mt-2">Cargando datos...</p>
    </div>
}
else
{
    <!-- TABLA EN TARJETA -->
    <div class="table-card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table custom-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">Id</th>
                        <th>Nombre</th>
                        <th>Profesor</th>
                        <th>Edad recomendada</th>
                        <th>Nivel</th>
                        <th class="text-center" style="width: 180px;">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var actividad in ListEntity)
                    {
                        <tr @key="actividad.Id">
                            <td class="fw-bold text-muted">#@actividad.Id</td>
                            <td class="fw-semibold text-dark">@actividad.Nombre</td>
                            <td>@(actividad.Profesor?.Nombre ?? "-")</td>
                            <td>@(actividad.EdadRecomendada ?? "-")</td>
                            <td>@(actividad.Nivel ?? "-")</td>

                            <!-- ACCIONES -->
                            <td class="text-center">
                                @if (MostrarEliminados)
                                {
                                    <button type="button"
                                            title="Restaurar actividad"
                                            class="btn btn-custom-success btn-sm me-1"
                                            @onclick="() => HandleRestaurar(actividad)">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Restaurar
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            title="Modificar actividad"
                                            class="btn btn-custom-edit btn-sm me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#NuevoEditarActividad"
                                            @onclick="() => HandleModificar(actividad)">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>

                                    <button type="button"
                                            title="Eliminar actividad"
                                            class="btn btn-custom-danger btn-sm"
                                            @onclick="() => HandleEliminar(actividad)">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter]
    public List<Actividad> ListEntity { get; set; } = new();

    [Parameter]
    public bool MostrarEliminados { get; set; }

    [Parameter]
    public EventCallback<Actividad> OnModificar { get; set; }

    [Parameter]
    public EventCallback<Actividad> OnEliminar { get; set; }

    [Parameter]
    public EventCallback<Actividad> OnRestaurar { get; set; }

    private async Task HandleModificar(Actividad actividad)
    {
        await OnModificar.InvokeAsync(actividad);
    }

    private async Task HandleEliminar(Actividad actividad)
    {
        await OnEliminar.InvokeAsync(actividad);
    }

    private async Task HandleRestaurar(Actividad actividad)
    {
        await OnRestaurar.InvokeAsync(actividad);
    }
}