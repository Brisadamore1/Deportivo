@if (actividadesFiltradas is null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="text-muted mt-2">Cargando datos...</p>
    </div>
}
else
{
    <!-- BUSCADOR CON EL MISMO DISEÑO QUE SOCIO -->
    <div class="search-box-container mb-4">
        <div class="input-group search-input-group">
            <span class="input-group-text bg-transparent border-end-0 pe-0">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input id="filterText"
                   type="text"
                   class="form-control border-start-0 ps-2"
                   value="@filterText"
                   @oninput="FilterList"
                   placeholder="Filtrar por nombre, nivel o profesor..." />
        </div>
    </div>

    <!-- TABLA EN TARJETA -->
    <div class="table-card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table custom-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">Id</th>
                        <th>Nombre</th>
                        <th>Profesor</th>
                        <th>Edad recomendada</th>
                        <th>Nivel</th>
                        <th class="text-center" style="width: 180px;">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var actividad in actividadesFiltradas)
                    {
                        <tr @key="actividad.Id">
                            <td class="fw-bold text-muted">#@actividad.Id</td>
                            <td class="fw-semibold text-dark">@actividad.Nombre</td>
                            <td>@(actividad.Profesor?.Nombre ?? "-")</td>
                            <td>@(actividad.EdadRecomendada ?? "-")</td>
                            <td>@(actividad.Nivel ?? "-")</td>

                            <!-- ACCIONES CON LOS MISMOS BOTONES E ÍCONOS QUE SOCIO -->
                            <td class="text-center">
                                @if (MostrarEliminados)
                                {
                                    <button type="button"
                                            title="Restaurar actividad"
                                            class="btn btn-custom-success btn-sm me-1"
                                            @onclick="() => HandleRestaurar(actividad)">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Restaurar
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            title="Modificar actividad"
                                            class="btn btn-custom-edit btn-sm me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#NuevoEditarActividad"
                                            @onclick="() => HandleModificar(actividad)">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>

                                    <button type="button"
                                            title="Eliminar actividad"
                                            class="btn btn-custom-danger btn-sm"
                                            @onclick="() => HandleEliminar(actividad)">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter]
    public List<Actividad> ListEntity { get; set; } = new();

    [Parameter]
    public bool MostrarEliminados { get; set; }

    [Parameter]
    public EventCallback<Actividad> OnModificar { get; set; }

    [Parameter]
    public EventCallback<Actividad> OnEliminar { get; set; }

    [Parameter]
    public EventCallback<Actividad> OnRestaurar { get; set; }

    private List<Actividad> actividadesFiltradas = new();
    private string filterText = string.Empty;

    protected override void OnParametersSet()
    {
        AplicarFiltro();
    }

    private async Task HandleModificar(Actividad actividad)
    {
        await OnModificar.InvokeAsync(actividad);
    }

    private async Task HandleEliminar(Actividad actividad)
    {
        await OnEliminar.InvokeAsync(actividad);
    }

    private async Task HandleRestaurar(Actividad actividad)
    {
        await OnRestaurar.InvokeAsync(actividad);
    }

    private void FilterList(ChangeEventArgs e)
    {
        filterText = e.Value?.ToString() ?? string.Empty;
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(filterText))
        {
            actividadesFiltradas = ListEntity.ToList();
            return;
        }

        actividadesFiltradas = ListEntity
            .Where(a =>
                a.Nombre.Contains(filterText, StringComparison.OrdinalIgnoreCase) ||
                (a.Nivel?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.EdadRecomendada?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Profesor?.Nombre?.Contains(filterText,
                    StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();
    }
}