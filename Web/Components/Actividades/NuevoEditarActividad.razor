@inject IGenericService<Profesor> _profesorService

<div class="modal fade" id="NuevoEditarActividad" tabindex="-1"
     aria-labelledby="tituloModalActividad" aria-hidden="true">

    <!-- DIÁLOGO CON CLASE DE ANCHO PERSONALIZADO -->
    <div class="modal-dialog modal-dialog-centered modal-custom-width">
        <div class="modal-content custom-modal-content">

            <!-- FORMULARIO DE BLAZOR -->
            <EditForm Model="@Actividad" OnValidSubmit="HandleGuardar">
                <DataAnnotationsValidator />

                <!-- CABECERA EN DEGRADÉ -->
                <div class="modal-header custom-modal-header text-white py-2 px-3">
                    <div>
                        <h6 class="modal-title fw-bold mb-0" id="tituloModalActividad">
                            @(Actividad?.Id > 0 ? "Editar actividad" : "Nueva actividad")
                        </h6>
                        <small class="modal-subtitle opacity-75">Complete la información de la actividad</small>
                    </div>

                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <!-- CUERPO DEL FORMULARIO -->
                <div class="modal-body p-3">
                    <div class="row g-2">
                        <!-- FILA 1: Nombre (6) y URL Imagen (6) -->
                        <div class="col-md-12">
                            <label for="nombreInput" class="custom-form-label">
                                Nombre <span class="text-danger">*</span>
                            </label>
                            <InputText id="nombreInput" class="form-control custom-form-input"
                                       placeholder="Ej: Tenis Infantil"
                                       @bind-Value="Actividad.Nombre" />
                            <ValidationMessage For="@(() => Actividad.Nombre)" class="text-danger small mt-1" />
                        </div>

                        <!-- FILA 2: Descripción (12) -->
                        <div class="col-12">
                            <label for="descripcionInput" class="custom-form-label">
                                Descripción <span class="text-danger">*</span>
                            </label>
                            <InputTextArea id="descripcionInput" class="form-control custom-form-input"
                                           rows="2"
                                           placeholder="Ingrese una descripción breve..."
                                           @bind-Value="Actividad.Descripcion" />
                            <ValidationMessage For="@(() => Actividad.Descripcion)" class="text-danger small mt-1" />
                        </div>

                        <!-- FILA 3: Edad recomendada (4), Nivel (4), Profesor (4) -->
                        <div class="col-md-4">
                            <label for="edadInput" class="custom-form-label">Edad recomendada</label>
                            <InputText id="edadInput" class="form-control custom-form-input"
                                       placeholder="Ej: Desde 6 años"
                                       @bind-Value="Actividad.EdadRecomendada" />
                        </div>

                        <div class="col-md-4">
                            <label for="nivelInput" class="custom-form-label">Nivel</label>
                            <InputText id="nivelInput"
                                       class="form-control custom-form-input"
                                       placeholder="Ej: Principiante"
                                       @bind-Value="Actividad.Nivel" />
                        </div>

                        <div class="col-md-4">
                            <label for="profesorInput" class="custom-form-label">Profesor</label>
                            <InputSelect id="profesorInput" class="form-select custom-form-select"
                                         @bind-Value="Actividad.ProfesorId">
                                <option value="0">Seleccione profesor</option>
                                @if (profesores != null)
                                {
                                    @foreach (var profesor in profesores)
                                    {
                                        <option value="@profesor.Id">@profesor.Nombre</option>
                                    }
                                }
                            </InputSelect>
                        </div>

                        <!-- FILA 4: Beneficios (12) -->
                        <div class="col-12">
                            <label for="beneficiosInput" class="custom-form-label">Beneficios</label>
                            <InputTextArea id="beneficiosInput" class="form-control custom-form-input"
                                           rows="2"
                                           placeholder="Beneficios de realizar esta actividad..."
                                           @bind-Value="Actividad.Beneficios" />
                        </div>
                    </div>
                </div>

                <!-- PIE DE PÁGINA / BOTONES -->
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-3 fw-semibold"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-action-primary px-4 fw-semibold">
                        Guardar cambios
                    </button>
                </div>

            </EditForm>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public Actividad Actividad { get; set; } = new();

    [Parameter]
    public EventCallback<Actividad> OnGuardar { get; set; }

    private List<Profesor> profesores = new();

    protected override async Task OnInitializedAsync()
    {
        profesores = await _profesorService.GetAllAsync()
                     ?? new List<Profesor>();
    }

    private async Task HandleGuardar()
    {
        if (OnGuardar.HasDelegate)
        {
            await OnGuardar.InvokeAsync(Actividad);
        }
    }
}