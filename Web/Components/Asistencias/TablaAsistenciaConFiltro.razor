<!-- Barra de búsqueda estilizada -->
<div class="card shadow-sm rounded-4 mb-3" style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 1rem !important;">
    <div class="card-body p-3">
        <div class="row align-items-center g-2">
            <div class="col-12 col-md-auto">
                <label for="filterText" class="fw-bold mb-0 small d-flex align-items-center gap-1" style="color: #274472;">
                    <i class="bi bi-search"></i> Buscar
                </label>
            </div>
            <div class="col-12 col-md">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted rounded-start-3" style="border-color: #cbd5e1;">
                        <i class="bi bi-funnel"></i>
                    </span>
                    <input id="filterText"
                           class="form-control border-start-0 rounded-end-3 ps-0"
                           style="border-color: #cbd5e1; font-size: 0.9rem;"
                           value="@filterText"
                           @oninput="FilterList"
                           placeholder="Filtrar por socio, actividad o fecha..." />
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla estructurada -->
<div class="card shadow-sm rounded-4 border-0 overflow-hidden" style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 1rem !important;">
    <div class="table-responsive mb-0">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color: #f8fafc; color: #274472;">
                <tr>
                    <th class="py-3 px-3 fw-bold" style="color: #274472;">Fecha</th>
                    <th class="py-3 fw-bold" style="color: #274472;">Socio</th>
                    <th class="py-3 fw-bold" style="color: #274472;">Actividad</th>
                    <th class="py-3 fw-bold" style="color: #274472;">Horario</th>
                    <th class="py-3 fw-bold" style="color: #274472;">Asistencia</th>
                    <th class="py-3 text-end px-3 fw-bold" style="color: #274472;" colspan="2">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var asistencia in asistenciasFiltradas)
                {
                    <tr @key="asistencia.Id">
                        <td class="px-3 fw-medium text-dark">
                            <i class="bi bi-calendar-event text-muted me-1"></i> @asistencia.Fecha.ToString("dd/MM/yyyy")
                        </td>
                        <td class="fw-bold" style="color: #274472;">
                            @(asistencia.Socio?.Nombre ?? "-")
                        </td>
                        <td class="text-secondary">
                            @(asistencia.Clase?.Actividad?.Nombre ?? "-")
                        </td>
                        <td class="text-secondary small">
                            <i class="bi bi-clock text-muted me-1"></i>
                            @(asistencia.Clase is null
                                                    ? "-"
                                                    : $"{asistencia.Clase.HoraInicio:hh\\:mm} - {asistencia.Clase.HoraFin:hh\\:mm}")
                    </td>
                    <td>
                        @if (asistencia.Presente)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-semibold">
                                    <i class="bi bi-check-circle-fill me-1"></i> Presente
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1 fw-semibold">
                                    <i class="bi bi-x-circle-fill me-1"></i> Ausente
                                </span>
                            }
                        </td>

                        @if (MostrarEliminados)
                        {
                            <td colspan="2" class="text-end px-3">
                                <button type="button" class="btn btn-sm btn-success rounded-3 px-3 fw-semibold d-inline-flex align-items-center gap-1"
                                        @onclick="() => HandleRestaurar(asistencia)">
                                    <i class="bi bi-arrow-counterclockwise"></i> Restaurar
                                </button>
                            </td>
                        }
                        else
                        {
                            <td class="text-end" style="width: 1%; white-space: nowrap;">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-3 px-2 py-1 d-inline-flex align-items-center gap-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#NuevoEditarModal"
                                        @onclick="() => HandleModificar(asistencia)"
                                        title="Modificar">
                                    <i class="bi bi-pencil-square"></i> Modificar
                                </button>
                            </td>

                            <td class="px-3" style="width: 1%; white-space: nowrap;">
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-3 px-2 py-1 d-inline-flex align-items-center gap-1"
                                        @onclick="() => HandleEliminar(asistencia)"
                                        title="Eliminar">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public List<Asistencia> ListEntity { get; set; } = new();

    [Parameter]
    public bool MostrarEliminados { get; set; }

    [Parameter]
    public EventCallback<Asistencia> OnModificar { get; set; }

    [Parameter]
    public EventCallback<Asistencia> OnEliminar { get; set; }

    [Parameter]
    public EventCallback<Asistencia> OnRestaurar { get; set; }

    private List<Asistencia> asistenciasFiltradas = new();
    private string filterText = string.Empty;

    protected override void OnParametersSet()
    {
        AplicarFiltro();
    }

    private async Task HandleModificar(Asistencia asistencia)
        => await OnModificar.InvokeAsync(asistencia);

    private async Task HandleEliminar(Asistencia asistencia)
        => await OnEliminar.InvokeAsync(asistencia);

    private async Task HandleRestaurar(Asistencia asistencia)
        => await OnRestaurar.InvokeAsync(asistencia);

    private void FilterList(ChangeEventArgs e)
    {
        filterText = e.Value?.ToString() ?? string.Empty;
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(filterText))
        {
            asistenciasFiltradas = ListEntity.ToList();
            return;
        }

        asistenciasFiltradas = ListEntity
            .Where(a =>
                (a.Socio?.Nombre?.Contains(filterText,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Clase?.Actividad?.Nombre?.Contains(filterText,
                    StringComparison.OrdinalIgnoreCase) ?? false) ||
                a.Fecha.ToString("dd/MM/yyyy").Contains(filterText))
            .ToList();
    }
}